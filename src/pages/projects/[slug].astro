---
import type { GetStaticPaths } from "astro";
import { getCollection, getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import config from "@/config";
import { playStoreUrl } from "@/utils/appLinks";

export const getStaticPaths = (async () => {
  const apps = await getCollection("apps");
  return apps.map(app => ({ params: { slug: app.id }, props: { app } }));
}) satisfies GetStaticPaths;

const { app } = Astro.props;
const d = app.data;
const { Content } = await render(app);
const hasPrivacy = Boolean(await getEntry("appPrivacy", app.id));
const otherApps = (await getCollection("apps")).filter(a => a.id !== app.id);
const accentVars = [
  d.accent && `--app-accent:${d.accent}`,
  d.accentDark && `--app-accent-dark:${d.accentDark}`,
]
  .filter(Boolean)
  .join(";");

const site = config.site;
const pageUrl = new URL(`/projects/${app.id}`, site.url).href;
const playUrl = d.playStoreId ? playStoreUrl(d.playStoreId, app.id) : undefined;
const ogImage = d.ogImage ?? d.heroImage ?? d.screenshots[0]?.src ?? d.icon;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: d.name,
    description: d.description,
    url: pageUrl,
    applicationCategory: d.category,
    operatingSystem: "Android",
    ...(d.icon && { image: new URL(d.icon, site.url).href }),
    ...(d.screenshots.length && {
      screenshot: d.screenshots.map(s => new URL(s.src, site.url).href),
    }),
    ...((playUrl || d.downloadUrl) && { downloadUrl: playUrl ?? d.downloadUrl }),
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    author: { "@type": "Person", name: site.author, url: site.profile },
    sameAs: [d.githubUrl],
  },
  ...(d.faq.length
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: d.faq.map(f => ({
            "@type": "Question",
            name: f.q,
            acceptedAnswer: { "@type": "Answer", text: f.a },
          })),
        },
      ]
    : []),
];
const structuredDataJson = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c"
);
---

<Layout title={d.title} description={d.description} ogImage={ogImage}>
  <Fragment slot="head">
    <meta name="keywords" content={d.keywords.join(", ")} />
    <script
      type="application/ld+json"
      is:inline
      set:html={structuredDataJson}
    />
  </Fragment>
  <Header />
  <Breadcrumb />
  <main
    id="main-content"
    class="app-layout app-page pb-12"
    style={accentVars}
    data-pagefind-body
  >
    <!-- Hero -->
    <section
      class="mt-4 overflow-hidden rounded-3xl px-5 py-8 text-white sm:px-8 sm:py-10"
      style={`background:${d.heroBg}`}
    >
      <div class="flex items-center gap-4">
        {
          d.icon && (
            <img
              src={d.icon}
              alt={`${d.name} app icon`}
              width="80"
              height="80"
              class="h-16 w-16 shrink-0 rounded-2xl shadow-lg sm:h-20 sm:w-20"
            />
          )
        }
        <div>
          <p class="text-sm tracking-widest uppercase opacity-70">Android app</p>
          <h1 class="text-2xl font-bold sm:text-3xl">{d.title}</h1>
        </div>
      </div>
      <p class="mt-4 text-lg opacity-90">{d.tagline}</p>

      <div class="mt-6 flex flex-wrap gap-3">
        {
          playUrl && (
            <a
              href={playUrl}
              class="hero-primary rounded-xl px-5 py-2.5 font-semibold hover:opacity-90"
            >
              Get it on Google Play
            </a>
          )
        }
        {
          d.downloadUrl && (
            <a
              href={d.downloadUrl}
              class:list={[
                "rounded-xl px-5 py-2.5 font-semibold hover:opacity-90",
                playUrl ? "border-2 border-white/60" : "hero-primary",
              ]}
            >
              {d.downloadLabel}
            </a>
          )
        }
        <a
          href={d.githubUrl}
          class="rounded-xl border-2 border-white/60 px-5 py-2.5 font-semibold hover:opacity-90"
        >
          Source on GitHub
        </a>
      </div>
      <p class="mt-4 text-sm opacity-70">Free · Open source · No ads</p>

      {
        d.heroImage && (
          <img
            src={d.heroImage}
            alt={`${d.name} preview`}
            class="mt-8 w-full rounded-2xl"
          />
        )
      }
    </section>

    {
      d.disclaimer && (
        <p class="bg-muted mt-6 rounded-lg px-4 py-3 text-sm">{d.disclaimer}</p>
      )
    }

    <!-- Screenshots in phone frames -->
    {
      d.screenshots.length > 0 && (
        <section class="mt-10 px-0" aria-label="Screenshots">
          <div class="-mx-4 flex snap-x gap-5 overflow-x-auto px-4 pb-3">
            {d.screenshots.map(s => (
              <figure class="w-44 shrink-0 snap-start sm:w-52">
                {d.screenshotFrame ? (
                  <div class="rounded-[2rem] bg-neutral-900 p-2 shadow-lg ring-1 ring-black/10">
                    <img
                      src={s.src}
                      alt={s.alt}
                      loading="lazy"
                      class="w-full rounded-[1.5rem]"
                    />
                  </div>
                ) : (
                  <img
                    src={s.src}
                    alt={s.alt}
                    loading="lazy"
                    class="w-full rounded-2xl shadow-lg ring-1 ring-black/10"
                  />
                )}
                {s.caption && (
                  <figcaption class="mt-3 text-center text-sm opacity-75">
                    {s.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <!-- Feature cards -->
    {
      d.features.length > 0 && (
        <section class="mt-10 px-0" aria-labelledby="features-heading">
          <h2 id="features-heading" class="text-accent text-xl font-bold sm:text-2xl">
            Features
          </h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {d.features.map(f => (
              <li class="rounded-2xl border p-4">
                <div class="flex items-center gap-2">
                  <span class="text-2xl" aria-hidden="true">{f.icon}</span>
                  <h3 class="font-semibold">{f.title}</h3>
                </div>
                <p class="mt-1 text-sm opacity-80">{f.text}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <article class="app-prose mt-10 max-w-none">
      <Content />

      {
        d.faq.length > 0 && (
          <>
            <h2>FAQ</h2>
            {d.faq.map(f => (
              <details>
                <summary>
                  <strong>{f.q}</strong>
                </summary>
                <p>{f.a}</p>
              </details>
            ))}
          </>
        )
      }
    </article>

    <!-- Related apps -->
    {
      otherApps.length > 0 && (
        <section class="mt-12 px-0" aria-labelledby="more-apps-heading">
          <h2 id="more-apps-heading" class="text-xl font-bold">
            More apps by {site.author}
          </h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {otherApps.map(a => (
              <li>
                <a
                  href={`/projects/${a.id}`}
                  class="hover:border-accent flex items-center gap-3 rounded-2xl border p-3"
                >
                  {a.data.icon && (
                    <img
                      src={a.data.icon}
                      alt=""
                      width="48"
                      height="48"
                      loading="lazy"
                      class="h-12 w-12 shrink-0 rounded-xl"
                    />
                  )}
                  <span>
                    <span class="block font-semibold">{a.data.name}</span>
                    <span class="block text-sm opacity-75">{a.data.tagline}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <hr class="my-8 border-dashed" />
    <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm" aria-label={`${d.name} links`}>
      {hasPrivacy && <a class="hover:text-accent underline" href={`/projects/${app.id}/privacy`}>Privacy policy</a>}
      <a class="hover:text-accent underline" href={`${d.githubUrl}/releases`}>Changelog</a>
      <a class="hover:text-accent underline" href={`${d.githubUrl}/issues`}>Report an issue</a>
      <a class="hover:text-accent underline" href="/projects">All projects</a>
    </nav>
  </main>
  <Footer />
</Layout>

<style is:global>
  /* Per-app brand colour: overrides the site accent inside the app page */
  .app-page {
    --accent: var(--app-accent, #2c72b2);
  }
  html[data-theme="dark"] .app-page {
    --accent: var(--app-accent-dark, var(--app-accent, #ff9100));
  }
  .app-page .hero-primary {
    background: var(--app-accent-dark, #ffffff);
    color: #111111;
  }
</style>
