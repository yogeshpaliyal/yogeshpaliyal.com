---
import type { CollectionEntry } from "astro:content";

type Props = CollectionEntry<"projects">;

const { data } = Astro.props;
const { title, description, url, icon } = data;
---

<li class:list={["my-6", { "flex items-start gap-4": icon }]}>
  {
    icon && (
      <a href={url} tabindex="-1" aria-hidden="true" class="shrink-0">
        <img
          src={icon}
          alt=""
          width="56"
          height="56"
          loading="lazy"
          class="size-14 rounded-2xl"
        />
      </a>
    )
  }
  <div>
    <a
      href={url}
      class:list={[
        "text-accent inline-block text-lg font-medium",
        "decoration-dashed underline-offset-4 hover:underline",
        "focus-visible:no-underline focus-visible:underline-offset-0",
      ]}
    >
      <h2>{title}</h2>
    </a>
    <p>{description}</p>
  </div>
</li>
